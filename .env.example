# PAKET 7 — Environment Configuration
# Copy to .env and adjust values

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# ============================================================
# DATABASE
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_tiket_event_pro
DB_USER=root
DB_PASS=

# ============================================================
# SESSION & COOKIES
# ============================================================
SESSION_SECURE=false
SESSION_SAMESITE=Strict
SESSION_LIFETIME=14400
SESSION_IDLE_TIMEOUT=1800
SESSION_COOKIE_NAME=pensi_session

# ============================================================
# SECURITY HEADERS
# ============================================================
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

CSP_NONCE_ENABLED=true
CSP_REPORT_ONLY=false

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_STORAGE=file
RATE_LIMIT_REDIS_HOST=127.0.0.1
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600

# ============================================================
# FILE UPLOADS
# ============================================================
UPLOAD_MAX_SIZE=2097152
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp
UPLOAD_PATH=storage/uploads/bukti
UPLOAD_SCAN_MIME=true
UPLOAD_STRIP_EXIF=true

# ============================================================
# LOGGING & AUDIT
# ============================================================
LOG_LEVEL=warning
LOG_PATH=storage/logs
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_PARTITION_MONTHLY=true

# ============================================================
# CRON / SCHEDULED TASKS
# ============================================================
CRON_EXPIRY_ENABLED=true
CRON_EXPIRY_SCHEDULE="* * * * *"
CRON_CLEANUP_ENABLED=true
CRON_CLEANUP_SCHEDULE="0 2 * * 0"
CRON_CLEANUP_DAYS=30